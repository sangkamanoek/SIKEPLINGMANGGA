rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SI KEPLING MANGGA - Firestore Security & Validation Rules
    // Enforces schema integrity, payload limits, and data validation

    // Helper functions
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // Koleksi Laporan Kinerja Utama
    match /SIKEPLINGMANGGA/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'tanggalLaporan'])
                   && isValidString(request.resource.data.id, 1, 100);
      allow delete: if true;
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id'])
                   && isValidString(request.resource.data.id, 1, 100);
      allow delete: if true;
    }

    // Target Capaian Kinerja (PBB, Perlinsos, IKD, dll.)
    match /targets_capaian/{keplingId} {
      allow read, write: if true;
    }

    // Passwords & Profile Sync
    match /account_passwords/{accountId} {
      allow read, write: if true;
    }

    match /account_profiles/{accountId} {
      allow read, write: if true;
    }

    match /deleted_reports/{reportId} {
      allow read, write: if true;
    }

    // Reminders & Notification Logs
    match /reminders/{reminderId} {
      allow read, write: if true;
    }

    match /notification_logs/{logId} {
      allow read, write: if true;
    }

    // Absensi Harian & Apel
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'tanggal'])
                   && isValidString(request.resource.data.id, 1, 100);
      allow delete: if true;
    }

    match /attendance_qr/{date} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'token', 'tanggal'])
                            && isValidString(request.resource.data.id, 1, 100);
      allow delete: if false;
    }

    // Agenda & Kegiatan Khusus
    match /custom_events/{eventId} {
      allow read, write: if true;
    }

    match /event_attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Kunjungan Warga (Door-to-Door)
    match /kunjungan_warga/{kunjunganId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'tanggal', 'namaWarga', 'alamat'])
                            && isValidString(request.resource.data.namaWarga, 1, 150)
                            && isValidString(request.resource.data.alamat, 1, 300);
      allow delete: if true;
    }

    // Database Data Keluarga (Profil Kartu Keluarga, Desil, Bansos, Sanitasi)
    match /data_keluarga/{keluargaId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'nomorKk', 'namaKepalaKeluarga'])
                            && isValidString(request.resource.data.id, 1, 120)
                            && isValidString(request.resource.data.nomorKk, 5, 50)
                            && isValidString(request.resource.data.namaKepalaKeluarga, 1, 200);
      allow delete: if true;
    }

    // WebGIS Batas Lingkungan, Titik Rumah & Ruas Jalan
    match /webgis_polygons/{docId} {
      allow read, write: if true;
    }

    match /webgis_houses/{docId} {
      allow read, write: if true;
    }

    match /webgis_roads/{docId} {
      allow read, write: if true;
    }

    // PBB SPPT Data per Tahun Pajak
    match /{pbbCollection}/{spptId} {
      allow read, write: if pbbCollection.matches('^pbb_sppt_.*');
    }

    // Realisasi Pembangunan & Laporan Pemantauan Kondisi Infrastruktur
    match /realisasi_pembangunan/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'namaProyek'])
                            && isValidString(request.resource.data.id, 1, 100);
      allow delete: if true;
    }

    match /laporan_infrastruktur/{docId} {
      allow read, write: if true;
    }

    // Laporan Keuangan & Buku Kas Umum Tim Penggerak PKK
    match /pkk_keuangan/{docId} {
      allow read, write: if true;
    }

    // Laporan Kegiatan & Dokumentasi 4 Pokja PKK & PKK Lingkungan
    match /pkk_kegiatan/{docId} {
      allow read, write: if true;
    }

    // Kelompok Dasa Wisma & Posyandu PKK
    match /pkk_dasa_wisma/{docId} {
      allow read, write: if true;
    }

    match /pkk_posyandu/{docId} {
      allow read, write: if true;
    }

    // Buku Administrasi TP PKK (Buku 1, 4, 5)
    match /pkk_buku_1_anggota/{docId} {
      allow read, write: if true;
    }
    match /pkk_buku_4_notulen/{docId} {
      allow read, write: if true;
    }
    match /pkk_buku_5_inventaris/{docId} {
      allow read, write: if true;
    }

    // Arsip Surat Kedinasan & Persuratan Kelurahan
    match /surat_kedinasan/{docId} {
      allow read, write: if true;
    }

    // Default Fallback Match
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
