{
  "entities": {
    "Report": {
      "title": "Laporan Harian",
      "description": "Laporan kegiatan harian yang dikirim oleh Kepala Lingkungan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik laporan" },
        "keplingId": { "type": "string", "description": "ID Kepling yang mengirim" },
        "tanggal": { "type": "string", "description": "Tanggal laporan" },
        "namaKepling": { "type": "string", "description": "Nama Kepling" },
        "jabatan": { "type": "string", "description": "Jabatan Kepling" },
        "kinerja": {
          "type": "object",
          "properties": {
            "pbb": { "type": "number" },
            "perlinsos": { "type": "number" },
            "ikd": { "type": "number" },
            "bpjs": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "namaKepling", "tanggal"]
    },
    "Attendance": {
      "title": "Presensi Apel",
      "description": "Catatan kehadiran apel pagi Kepling.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "namaKepling": { "type": "string" },
        "tanggal": { "type": "string" },
        "status": { "type": "string", "enum": ["Hadir", "Izin", "Sakit", "Dinas Luar", "Tidak Mengikuti Apel"] },
        "waktuLengkap": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "accountId", "tanggal", "status"]
    },
    "Target": {
      "title": "Target Capaian",
      "description": "Target kinerja dan penyesuaian (override) untuk tiap Kepling.",
      "type": "object",
      "properties": {
        "keplingId": { "type": "string" },
        "targetPerlinsos": { "type": "number" },
        "targetPbb": { "type": "number" },
        "targetIkd": { "type": "number" },
        "targetBpjs": { "type": "number" },
        "overridePerlinsos": { "type": ["number", "null"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["keplingId"]
    },
    "AccountPassword": {
      "title": "Sandi Akun",
      "description": "Sinkronisasi sandi kustom antar perangkat.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "password": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountId", "password"]
    },
    "AccountProfile": {
      "title": "Profil Akun",
      "description": "Sinkronisasi nama dan telepon kustom.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "nama": { "type": "string" },
        "telepon": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountId"]
    }
  },
  "firestore": {
    "reports/{reportId}": {
      "schema": "Report",
      "description": "Koleksi utama laporan harian."
    },
    "attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Koleksi presensi apel pagi."
    },
    "targets_capaian/{keplingId}": {
      "schema": "Target",
      "description": "Konfigurasi target dan penyesuaian capaian."
    },
    "account_passwords/{accountId}": {
      "schema": "AccountPassword",
      "description": "Penyimpanan sandi kustom."
    },
    "account_profiles/{accountId}": {
      "schema": "AccountProfile",
      "description": "Penyimpanan profil kustom."
    },
    "deleted_reports/{reportId}": {
      "schema": { "type": "object", "properties": { "id": { "type": "string" }, "deletedAt": { "type": "string" } } },
      "description": "Tombstone untuk laporan yang dihapus."
    }
  }
}
