{
  "entities": {
    "Report": {
      "title": "Laporan Harian",
      "description": "Laporan kegiatan harian yang dikirim oleh Kepala Lingkungan.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID unik laporan" },
        "keplingId": { "type": "string", "description": "ID Kepling yang mengirim" },
        "tanggal": { "type": "string", "description": "Tanggal laporan" },
        "namaKepling": { "type": "string", "description": "Nama Kepling" },
        "jabatan": { "type": "string", "description": "Jabatan Kepling" },
        "kinerja": {
          "type": "object",
          "properties": {
            "pbb": { "type": "number" },
            "perlinsos": { "type": "number" },
            "ikd": { "type": "number" },
            "bpjs": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "namaKepling", "tanggal"]
    },
    "Attendance": {
      "title": "Presensi Apel",
      "description": "Catatan kehadiran apel pagi Kepling.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "namaKepling": { "type": "string" },
        "tanggal": { "type": "string" },
        "status": { "type": "string", "enum": ["Hadir", "Izin", "Sakit", "Dinas Luar", "Tidak Mengikuti Apel"] },
        "waktuLengkap": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "accountId", "tanggal", "status"]
    },
    "AttendanceQR": {
      "title": "QR Code Apel Pagi",
      "description": "QR code untuk validasi lokasi apel pagi Kepling.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string" },
        "tanggal": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "token", "tanggal"]
    },
    "Target": {
      "title": "Target Capaian",
      "description": "Target kinerja dan penyesuaian (override) untuk tiap Kepling.",
      "type": "object",
      "properties": {
        "keplingId": { "type": "string" },
        "targetPerlinsos": { "type": "number" },
        "targetPbb": { "type": "number" },
        "targetIkd": { "type": "number" },
        "targetBpjs": { "type": "number" },
        "overridePerlinsos": { "type": ["number", "null"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["keplingId"]
    },
    "AccountPassword": {
      "title": "Sandi Akun",
      "description": "Sinkronisasi sandi kustom antar perangkat.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "password": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountId", "password"]
    },
    "AccountProfile": {
      "title": "Profil Akun",
      "description": "Sinkronisasi nama dan telepon kustom.",
      "type": "object",
      "properties": {
        "accountId": { "type": "string" },
        "nama": { "type": "string" },
        "telepon": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountId"]
    },
    "UserAccount": {
      "title": "Akun Pengguna Resmi",
      "description": "Basis data akun resmi 59 pengguna (Lurah, Seklur, Kasi, Bapenda, 24 Kepling, dan PKK).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" },
        "nama": { "type": "string" },
        "jabatan": { "type": "string" },
        "lingkungan": { "type": "string" },
        "password": { "type": "string" },
        "nomorLingkungan": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username", "role", "nama", "password"]
    },

    "RealisasiPembangunan": {
      "title": "Realisasi Pembangunan Infrastruktur",
      "description": "Basis data monitoring realisasi proyek dan pemantauan kondisi fisik infrastruktur wilayah.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lingkunganId": { "type": "string" },
        "lingkunganNomor": { "type": "number" },
        "jenisPembangunan": { "type": "string" },
        "namaProyek": { "type": "string" },
        "lokasiDetail": { "type": "string" },
        "sumberDana": { "type": "string" },
        "statusRealisasi": { "type": "string" },
        "volumeRealisasi": { "type": "string" },
        "biayaEstimasiRp": { "type": "number" },
        "tanggalMulai": { "type": "string" },
        "tanggalSelesai": { "type": "string" },
        "fotoSebelumUrl": { "type": "string" },
        "fotoProsesUrl": { "type": "string" },
        "fotoProsesList": { "type": "array" },
        "fotoSesudahUrl": { "type": "string" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdByName": { "type": "string" }
      },
      "required": ["id", "namaProyek", "lingkunganNomor"]
    },
    "TugasKhusus": {
      "title": "Tugas Khusus Lurah",
      "description": "Instruksi dan tugas khusus resmi dari Lurah yang ditujukan kepada Kepala Lingkungan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "judul": { "type": "string" },
        "deskripsi": { "type": "string" },
        "targetAccountId": { "type": "string" },
        "targetRole": { "type": "string" },
        "pemberiTugas": { "type": "string" },
        "tanggalMulai": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string", "enum": ["aktif", "selesai"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "completedBy": { "type": "array" }
      },
      "required": ["id", "judul", "deskripsi", "status"]
    },
    "TugasKhususSubmission": {
      "title": "Dokumentasi Tugas Khusus",
      "description": "Laporan foto bukti dan catatan pelaksanaan tugas khusus oleh Kepling.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "accountId": { "type": "string" },
        "namaKepling": { "type": "string" },
        "fotoUrl": { "type": "string" },
        "keterangan": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "taskId", "fotoUrl"]
    },
    "PkkKeuangan": {
      "title": "Keuangan PKK (BKU)",
      "description": "Pencatatan kas masuk dan kas keluar BKU TP PKK Kelurahan Mangga.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tanggal": { "type": "string" },
        "uraian": { "type": "string" },
        "jenis": { "type": "string", "enum": ["Penerimaan", "Pengeluaran"] },
        "nominal": { "type": "number" },
        "nomorBukti": { "type": "string" },
        "sumberAtauPenerima": { "type": "string" },
        "kategori": { "type": "string" },
        "keterangan": { "type": "string" }
      },
      "required": ["id", "tanggal", "uraian", "jenis", "nominal"]
    },
    "PkkKegiatan": {
      "title": "Laporan Kegiatan Pokja PKK",
      "description": "Laporan dan foto dokumentasi kegiatan 4 Pokja dan PKK Lingkungan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pokjaCategory": { "type": "string" },
        "tanggal": { "type": "string" },
        "namaKegiatan": { "type": "string" },
        "lokasi": { "type": "string" },
        "deskripsi": { "type": "string" },
        "dokumentasiFoto": { "type": "array" }
      },
      "required": ["id", "pokjaCategory", "tanggal", "namaKegiatan"]
    },
    "PkkDasaWisma": {
      "title": "Data Dasa Wisma PKK",
      "description": "Rekapitulasi data anggota dan statistik kelompok Dasa Wisma per lingkungan.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lingkunganNomor": { "type": "number" },
        "namaKelompok": { "type": "string" },
        "namaKetuaDawis": { "type": "string" },
        "jumlahKk": { "type": "number" },
        "jumlahJiwa": { "type": "number" }
      },
      "required": ["id", "lingkunganNomor", "namaKelompok"]
    },
    "PkkPosyandu": {
      "title": "Laporan Posyandu Pokja IV",
      "description": "Dokumentasi dan rekap pelayanan Posyandu Balita & Lansia.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namaPosyandu": { "type": "string" },
        "tanggal": { "type": "string" },
        "jumlahBalitaHadir": { "type": "number" }
      },
      "required": ["id", "namaPosyandu", "tanggal"]
    },
    "PkkBuku1": {
      "title": "Buku 1 Administrasi PKK (Data Anggota)",
      "description": "Data susunan kepengurusan dan anggota TP PKK.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "jabatan": { "type": "string" },
        "jenisKelamin": { "type": "string" }
      },
      "required": ["id", "nama", "jabatan"]
    },
    "PkkBuku4": {
      "title": "Buku 4 Administrasi PKK (Notulen Rapat)",
      "description": "Catatan notulen dan keputusan rapat PKK.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pimpinanRapat": { "type": "string" },
        "jumlahPeserta": { "type": "number" }
      },
      "required": ["id", "pimpinanRapat"]
    },
    "PkkBuku5": {
      "title": "Buku 5 Administrasi PKK (Inventaris)",
      "description": "Inventarisasi aset dan barang milik TP PKK.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namaBarang": { "type": "string" },
        "asalBarang": { "type": "string" },
        "jumlah": { "type": "number" }
      },
      "required": ["id", "namaBarang"]
    }
  },
  "firestore": {
    "pkk_keuangan/{docId}": {
      "schema": "PkkKeuangan",
      "description": "Koleksi transaksi kas BKU PKK."
    },
    "pkk_kegiatan/{docId}": {
      "schema": "PkkKegiatan",
      "description": "Koleksi kegiatan dan dokumentasi 4 Pokja PKK."
    },
    "pkk_dasa_wisma/{docId}": {
      "schema": "PkkDasaWisma",
      "description": "Koleksi data kelompok Dasa Wisma PKK."
    },
    "pkk_posyandu_reports/{docId}": {
      "schema": "PkkPosyandu",
      "description": "Koleksi laporan kegiatan Posyandu PKK."
    },
    "pkk_buku_1_anggota/{docId}": {
      "schema": "PkkBuku1",
      "description": "Koleksi Buku 1 Administrasi PKK (Data Anggota TP PKK)."
    },
    "pkk_buku_4_notulen/{docId}": {
      "schema": "PkkBuku4",
      "description": "Koleksi Buku 4 Administrasi PKK (Notulen Rapat PKK)."
    },
    "pkk_buku_5_inventaris/{docId}": {
      "schema": "PkkBuku5",
      "description": "Koleksi Buku 5 Administrasi PKK (Inventaris Aset PKK)."
    },
    "tugas_khusus/{docId}": {
      "schema": "TugasKhusus",
      "description": "Koleksi tugas khusus lurah tersinkronisasi real-time ke seluruh HP."
    },
    "tugas_khusus_submissions/{docId}": {
      "schema": "TugasKhususSubmission",
      "description": "Koleksi bukti foto dan dokumentasi pengerjaan tugas khusus oleh Kepling."
    },
    "realisasi_pembangunan/{docId}": {
      "schema": "RealisasiPembangunan",
      "description": "Koleksi proyek realisasi pembangunan dan pemantauan fisik infrastruktur."
    },

    "reports/{reportId}": {
      "schema": "Report",
      "description": "Koleksi utama laporan harian."
    },
    "attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Koleksi presensi apel pagi."
    },
    "attendance_qr/{date}": {
      "schema": "AttendanceQR",
      "description": "Koleksi untuk QR code harian."
    },
    "targets_capaian/{keplingId}": {
      "schema": "Target",
      "description": "Konfigurasi target dan penyesuaian capaian."
    },
    "account_passwords/{accountId}": {
      "schema": "AccountPassword",
      "description": "Penyimpanan sandi kustom dan sinkronisasi kata sandi akun."
    },
    "user_accounts/{accountId}": {
      "schema": "UserAccount",
      "description": "Basis data akun resmi 59 pengguna (Lurah, Seklur, Kasi, Bapenda, 24 Kepling, dan PKK)."
    },
    "account_profiles/{accountId}": {
      "schema": "AccountProfile",
      "description": "Penyimpanan profil kustom."
    },
    "deleted_reports/{reportId}": {
      "schema": { "type": "object", "properties": { "id": { "type": "string" }, "deletedAt": { "type": "string" } } },
      "description": "Tombstone untuk laporan yang dihapus."
    }
  }
}
